{
  "name": "@loomcast/studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Loomcast video studio: HyperFrames workspace, style library, producer skills and the render runtime the studio agent drives.",
  "exports": {
    "./runtime": "./runtime/src/index.ts"
  },
  "scripts": {
    "transcribe": "node scripts/transcribe-elevenlabs.mjs",
    "validate-beats": "node scripts/validate-beat-sync.mjs",
    "preflight": "node scripts/preflight.mjs",
    "setup": "node scripts/setup.mjs",
    "new-video": "node scripts/new-video.mjs",
    "demo": "node scripts/new-video.mjs demo",
    "catalog": "node scripts/style-library/build-registry.mjs",
    "test:media": "node scripts/smoke-media.mjs",
    "preflight:all": "node scripts/preflight-all.mjs",
    "runtime": "tsx runtime/src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "LOOMCAST_SMOKE_RENDER=1 HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1 vitest run runtime/test/smoke.test.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@loomcast/contracts": "workspace:*",
    "parse5": "^8.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "gsap": "3.14.2",
    "hyperframes": "0.7.109",
    "playwright": "^1.59.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
