# Backup service settings for compose.prod.yml.
# Production copy: /opt/loomcast/env/backup.env (owner root, mode 0600). Placeholders only:
# secrets are left empty here. Never commit a filled-in copy.
#
# Write each value on its own line, without quotes or trailing comments.
# The database connection comes from postgres.env (POSTGRES_USER, POSTGRES_PASSWORD and
# POSTGRES_DB), which compose passes to this service too. PGHOST, PGPORT and BACKUP_DIR are set
# by compose.prod.yml. docs/runbooks/backup-and-restore.md explains every setting.

# ---------------------------------------------------------------------------
# Schedule and local rotation
# ---------------------------------------------------------------------------

# Time of the daily backup, HH:MM in UTC.
BACKUP_AT=02:30

# Local copies kept in /opt/loomcast/backups/daily and /opt/loomcast/backups/weekly.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# Day of the weekly copy: 1 is Monday, 7 is Sunday.
BACKUP_WEEKLY_DAY=7

# ---------------------------------------------------------------------------
# Off-site copy in object storage (the private loomcast-backups bucket on R2)
# ---------------------------------------------------------------------------

# true uploads every backup and fails the run when the upload fails; false keeps backups on this
# host only; auto uploads when BACKUP_S3_ENDPOINT is set.
BACKUP_UPLOAD=true

# R2 S3 API endpoint of the account: https://<account id>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=loomcast-backups
BACKUP_S3_REGION=auto

# Required for uploads. A scoped R2 API token with object read and write on the backups bucket
# only; generate it in the Cloudflare dashboard (see the R2 runbook).
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Recommended. age public key (age1...) that backups are encrypted to before they leave the host;
# several keys are separated by commas. Only the public key goes on the server: keep the matching
# identity file offline (password manager), because without it the off-site copies cannot be
# restored. Empty uploads unencrypted.
BACKUP_AGE_RECIPIENT=

# ---------------------------------------------------------------------------
# Alerts on a failed backup (optional; the same webhook as the api's alerts)
# ---------------------------------------------------------------------------

ALERT_WEBHOOK_URL=
# json, ntfy or slack.
ALERT_WEBHOOK_FORMAT=json
