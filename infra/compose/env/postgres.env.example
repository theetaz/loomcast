# Database credentials for compose.prod.yml: the loomcast role and database on the host's shared
# Postgres (platform-postgres). The backup service reads them; api.env's DATABASE_URL repeats them.
# Production copy: /opt/loomcast/env/postgres.env (owner root, mode 0600). Placeholders only.
# Rotate the password with ALTER ROLE on the shared server and update api.env to match.

POSTGRES_USER=loomcast
POSTGRES_DB=loomcast

# Required. Generate it on the server, for example with `openssl rand -hex 32` (hex needs no URL
# escaping in DATABASE_URL). Never reuse it elsewhere.
POSTGRES_PASSWORD=
