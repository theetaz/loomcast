# Api service settings for compose.prod.yml.
# Production copy: /opt/loomcast/env/api.env (owner root, mode 0600). Placeholders only: secrets
# are left empty here and generated on the server. Never commit a filled-in copy.
#
# Write each value on its own line, without quotes or trailing comments.
# NODE_ENV, API_PORT, NODE_OPTIONS and BACKUP_DIR are set by compose.prod.yml; WEB_DIST_DIR,
# MIGRATIONS_DIR and LOOMCAST_GIT_SHA by the image. Do not set them here. Leave API_HOST unset too: in production the
# api listens on every interface of the container, which the published port needs.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Required. Postgres connection string for the host's shared server (platform-postgres on the
# "platform" network) on port 5432, using POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB from
# postgres.env:
#   postgres://<user>:<password>@platform-postgres:5432/<database>
DATABASE_URL=

# Required. Public origin of the app; unsafe requests must come from it.
APP_ORIGIN=https://loomcast.prabhavalabs.com

# Required. Base URL of the public media bucket's custom domain (no trailing slash).
PUBLIC_BASE_URL=https://loomcast-media.prabhavalabs.com

# The host's reverse proxy appends the client address to X-Forwarded-For, so trust it.
# Rate limits key on the wrong address without it.
TRUST_PROXY=true

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Required. Encryption of stored channel credentials: 32 random bytes, base64 encoded
# (`openssl rand -base64 32`). The api refuses to start without it, or with a key of another
# length. Keep a copy in a password manager: without it, stored credentials cannot be decrypted.
LOOMCAST_ENCRYPTION_KEY=
LOOMCAST_ENCRYPTION_KEY_VERSION=1
# Earlier keys during a rotation, as version:key pairs separated by commas (for example
# 1:<old key>). Rotate with `node dist/cli/vault.mjs rotate`, then clear this line.
LOOMCAST_ENCRYPTION_KEYS_PREVIOUS=

# Scheduler: the background task loop (cadence planning, publishing, asset cleanup) and how often
# it claims due tasks, in milliseconds. CADENCE_HORIZON_DAYS is how far ahead slots are planned.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=5000
CADENCE_HORIZON_DAYS=14

# Publishing. dry-run records what would be posted without calling the platforms; switch to live
# only after the go-live review. PUBLISHING_ENABLED=false pauses publishing entirely.
PUBLISHING_MODE=dry-run
PUBLISHING_ENABLED=true

# Alerts: a webhook called on dead tasks, publish failures, reauthorisation and stale backups,
# at most once an hour per alert. Leave it empty to only log alerts (docker compose logs). The
# URL is a secret (ntfy topic, Slack or Discord hook path). Formats: json (any receiver), ntfy,
# or slack (Slack incoming webhooks, and Discord with /slack appended to its webhook URL). Use
# the same values in backup.env. See docs/runbooks/monitoring.md.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=json

# Meta (Facebook Pages and Instagram) and Threads apps, for connecting channels. Fill them in at
# checkpoint C7 (docs/runbooks/meta-app-setup.md), then check them with
# `node dist/cli/meta-check.mjs`. Each provider's values are set together; left empty, the
# provider is offered as not configured. META_GRAPH_VERSION is the Graph API version the api
# targets.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
THREADS_APP_ID=
THREADS_APP_SECRET=
# Base of the OAuth redirect URIs registered with the platforms; defaults to APP_ORIGIN, so leave
# it unset in production.
# OAUTH_REDIRECT_BASE=
# Test-only overrides of the platform API hosts. Leave unset in production.
# META_GRAPH_BASE_URL=
# THREADS_GRAPH_BASE_URL=

# ---------------------------------------------------------------------------
# Settings for features still being built. Each one is read once its feature ships; until then
# the api ignores it. Uncomment and fill in the lines as the features are deployed. A value on a
# commented line is the planned default, or the expected value for bucket names.
# ---------------------------------------------------------------------------

# Object storage (S3-compatible; production uses Cloudflare R2). Required in production: the api
# refuses to start without the endpoint and both keys. The app token needs Object Read & Write on
# the media and public buckets and must not have an IP filter (browsers and the studio agent use
# presigned URLs). See docs/runbooks/r2.md.
# Endpoint form: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_BUCKET=loomcast-media
S3_PUBLIC_BUCKET=loomcast-public
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Largest upload the api hashes itself when the store keeps no checksum, in bytes. R2 does not
# report upload checksums, so cover the largest render (1 GiB).
ASSET_VERIFY_MAX_BYTES=1073741824

# X publishing (off unless the paid API tier is in use).
# FEATURE_X_PUBLISHING=false
# X_CLIENT_ID=
# X_CLIENT_SECRET=
