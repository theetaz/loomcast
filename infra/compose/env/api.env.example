# Api service settings for compose.prod.yml.
# Production copy: /opt/loomcast/env/api.env (owner root, mode 0600). Placeholders only: secrets
# are left empty here and generated on the server. Never commit a filled-in copy.
#
# Write each value on its own line, without quotes or trailing comments.
# NODE_ENV, API_PORT and NODE_OPTIONS are set by compose.prod.yml; WEB_DIST_DIR and
# MIGRATIONS_DIR by the image. Do not set them here. Leave API_HOST unset too: in production the
# api listens on every interface of the container, which the published port needs.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Required. Postgres connection string for the compose service "postgres" on port 5432, using
# POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB from postgres.env:
#   postgres://<user>:<password>@postgres:5432/<database>
DATABASE_URL=

# Required. Public origin of the app; unsafe requests must come from it.
APP_ORIGIN=https://loomcast.prabhavalabs.com

# Required. Base URL of the public media bucket's custom domain, for example
# https://media.example.com (no trailing slash).
PUBLIC_BASE_URL=

# The host's reverse proxy appends the client address to X-Forwarded-For, so trust it.
# Rate limits key on the wrong address without it.
TRUST_PROXY=true

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Settings for features still being built. Each one is read once its feature ships; until then
# the api ignores it. Uncomment and fill in the lines as the features are deployed. A value on a
# commented line is the planned default, or the expected value for bucket names.
# ---------------------------------------------------------------------------

# Object storage (S3-compatible; production uses a private media bucket and a public bucket).
# S3_ENDPOINT=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=
# S3_BUCKET=loomcast-media
# S3_PUBLIC_BUCKET=loomcast-public
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Largest upload the api verifies, in bytes (512 MiB).
# ASSET_VERIFY_MAX_BYTES=536870912

# Encryption of stored channel credentials. The key is 32 random bytes, base64 encoded
# (`openssl rand -base64 32`), and is required in production. Keep a copy in a password manager:
# without it, stored credentials cannot be decrypted.
# LOOMCAST_ENCRYPTION_KEY=
# LOOMCAST_ENCRYPTION_KEY_VERSION=1
# Earlier keys during a rotation, as version:key pairs separated by commas.
# LOOMCAST_ENCRYPTION_KEYS_PREVIOUS=

# Scheduler. SCHEDULER_ENABLED switches the background task loop on or off.
# SCHEDULER_ENABLED=
# SCHEDULER_TICK_MS=5000
# CADENCE_HORIZON_DAYS=14

# Publishing. dry-run records what would be posted without calling the platforms; switch to live
# only after the go-live review. PUBLISHING_ENABLED=false pauses publishing entirely.
# PUBLISHING_MODE=dry-run
# PUBLISHING_ENABLED=

# Meta (Facebook and Instagram) and Threads apps.
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# META_GRAPH_VERSION=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# Base of the OAuth redirect URIs registered with the platforms; defaults to APP_ORIGIN.
# OAUTH_REDIRECT_BASE=
# Test-only overrides of the platform API base URLs. Leave unset in production.
# META_GRAPH_BASE_URL=
# THREADS_GRAPH_BASE_URL=

# X publishing (off unless the paid API tier is in use).
# FEATURE_X_PUBLISHING=false
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Alerts: a webhook called on dead tasks, publish failures, reauthorisation and stale backups.
# ALERT_WEBHOOK_URL=
# json, ntfy or slack.
# ALERT_WEBHOOK_FORMAT=
