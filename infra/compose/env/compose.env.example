# Interpolation variables for compose.prod.yml, passed with `--env-file`.
# Production copy: /opt/loomcast/env/compose.env (owner root, mode 0600). Placeholders only.
#
# This example points at the committed templates so that, from a checkout,
#   docker compose -f infra/compose/compose.prod.yml --env-file infra/compose/env/compose.env.example config
# resolves. Change the last two settings as described before using it on a server.

# Image tag to run. The deploy script sets it for each release (sha-<short commit>).
LOOMCAST_TAG=main

# Loopback port the host's reverse proxy forwards to. Pick one that no other stack on the host
# uses. The api is published on 127.0.0.1 only.
LOOMCAST_HTTP_PORT=18790

# Memory cap of the api container, and the V8 heap ceiling in MiB (about 70 % of the cap).
API_MEM=640m
API_HEAP_MB=448

# Directory holding api.env and postgres.env. Production: /opt/loomcast/env
LOOMCAST_ENV_DIR=./env

# Appended to every env file name. Only this repository example uses ".example"; leave it empty
# (or delete the line) in production.
LOOMCAST_ENV_SUFFIX=.example
