# Local development settings. Copy to .env and fill in only what you need.
# Values for the local stack are safe defaults. Never commit a filled-in .env.
DATABASE_URL=postgres://loomcast:loomcast@127.0.0.1:55434/loomcast
TEST_DATABASE_ADMIN_URL=postgres://loomcast:loomcast@127.0.0.1:55434/postgres
APP_ORIGIN=http://localhost:5173
API_PORT=8790
# Public base URL for published media. Set to the R2 public domain outside local development.
PUBLIC_BASE_URL=https://media.example.com
# Local SeaweedFS stands in for Cloudflare R2. These keys match infra/seaweedfs/s3.json (dev only).
S3_ENDPOINT=http://127.0.0.1:59000
S3_BUCKET=loomcast-media
S3_ACCESS_KEY=loomcast-dev-access
S3_SECRET_KEY=loomcast-dev-secret
LOG_LEVEL=info
