# Local development settings. Copy to .env and fill in only what you need.
# Values for the local stack are safe defaults. Never commit a filled-in .env.
DATABASE_URL=postgres://loomcast:loomcast@127.0.0.1:55434/loomcast
TEST_DATABASE_ADMIN_URL=postgres://loomcast:loomcast@127.0.0.1:55434/postgres
APP_ORIGIN=http://localhost:5173
API_PORT=8790
# Public base URL of the public media bucket (published renders). Locally that is the
# anonymously readable loomcast-public bucket; outside local development, its R2 custom domain.
PUBLIC_BASE_URL=http://127.0.0.1:59000/loomcast-public
# Local SeaweedFS stands in for Cloudflare R2. These keys match infra/seaweedfs/s3.json (dev only).
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Private bucket for every upload, and the public-read bucket only promoted renders are copied to.
S3_BUCKET=loomcast-media
S3_PUBLIC_BUCKET=loomcast-public
S3_ACCESS_KEY=loomcast-dev-access
S3_SECRET_KEY=loomcast-dev-secret
# Largest upload the API hashes itself when the store did not record its checksum (512 MiB).
ASSET_VERIFY_MAX_BYTES=536870912
LOG_LEVEL=info
# Token vault key that encrypts channel credentials: 32 random bytes, base64 encoded
# (openssl rand -base64 32). Optional locally: without it, storing credentials answers 503.
LOOMCAST_ENCRYPTION_KEY=
LOOMCAST_ENCRYPTION_KEY_VERSION=1
# Earlier keys during a rotation, as version:key pairs separated by commas.
LOOMCAST_ENCRYPTION_KEYS_PREVIOUS=
# Scheduled tasks (cadence planning, publishing, asset cleanup) and how often due ones are claimed.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=5000
# dry-run records what would be posted without calling the platforms. Keep it locally.
PUBLISHING_MODE=dry-run
PUBLISHING_ENABLED=true
CADENCE_HORIZON_DAYS=14
# Meta (Facebook Pages and Instagram) and Threads apps, for connecting channels. Optional: without
# them the connect page answers not_configured. See docs/runbooks/meta-app-setup.md; each
# provider's values are set together. Never commit real values.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
THREADS_APP_ID=
THREADS_APP_SECRET=
# X publishing is off unless FEATURE_X_PUBLISHING=true. While it is off nothing is sent to X: X is
# not offered for connecting, X channels cannot be created and X posts are refused. The X app is an
# OAuth 2.0 confidential client (both values set together). Never commit real values.
FEATURE_X_PUBLISHING=false
X_CLIENT_ID=
X_CLIENT_SECRET=
# Base of the OAuth redirect URIs (defaults to APP_ORIGIN); a tunnel URL for local sign-ins.
OAUTH_REDIRECT_BASE=
# Platform API hosts, overridable for E2E runs against a fake. Leave empty for Meta's hosts.
META_GRAPH_BASE_URL=
THREADS_GRAPH_BASE_URL=
# Leave empty for api.x.com.
X_API_BASE_URL=
