{
  "name": "@loomcast/studio-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Loomcast studio agent: pairs a Mac with the server and runs allow-listed jobs over the bridge",
  "type": "module",
  "bin": {
    "studio-agent": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@loomcast/contracts": "workspace:*",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
