{
  "name": "@loomcast/api",
  "version": "0.1.0",
  "private": true,
  "description": "Loomcast API server: REST, auth, tokens, jobs, bridge hub, MCP and the admin CLI",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.mjs",
    "start:prod": "node dist/cli/migrate-and-start.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "admin": "tsx src/cli/admin.ts",
    "admin:create": "tsx src/cli/admin.ts create",
    "admin:token": "tsx src/cli/admin.ts token",
    "admin:reset-password": "tsx src/cli/admin.ts reset-password"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@hono/node-server": "catalog:",
    "@loomcast/contracts": "workspace:*",
    "@loomcast/db": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@node-rs/argon2": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/ws": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
